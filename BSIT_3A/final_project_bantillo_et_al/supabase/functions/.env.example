# Copy to supabase/functions/.env and add your Gemini API key.
# For the cloud, upload this ignored file as Supabase secrets with:
#   supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env file.
GEMINI_API_KEY=
# Model name from Google AI Studio; change it here without code edits.
GEMINI_MODEL=
