# Copy to supabase/functions/.env for local `supabase functions serve`.
# In the cloud, set them as secrets instead:
#   supabase secrets set GEMINI_API_KEY=your-key GEMINI_MODEL=gemini-2.5-flash
# Never commit the real .env file.
GEMINI_API_KEY=
# Model name from Google AI Studio; change it here without code edits.
GEMINI_MODEL=gemini-2.5-flash
